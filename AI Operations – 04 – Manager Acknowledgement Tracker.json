    {
      "parameters": {
        "jsCode": "\nconst alerts = $(\"Read Manager Acknowledgement Records\").all();\nconst tasks = $(\"Read Manager Acknowledgement Status\").all();\n\nconst taskMap = new Map();\n\nfor (const item of tasks) {\n  const task = item.json;\n  const cycleId = String(task.Cycle_ID || \"\").trim();\n\n  if (cycleId) {\n    taskMap.set(cycleId, task);\n  }\n}\n\nconst now = new Date();\nconst results = [];\n\nfor (const item of alerts) {\n  const alert = item.json;\n  const cycleId = String(alert.Cycle_ID || \"\").trim();\n\n  // Ignore empty placeholder records\n  if (!cycleId || !alert.Alert_ID) continue;\n\n  // Skip acknowledged or already escalated alerts\n  if (\n    String(alert.Manager_Acknowledged).toLowerCase() === \"true\" ||\n    String(alert.Leadership_Escalated).toLowerCase() === \"true\"\n  ) {\n    continue;\n  }\n\n  if (String(alert.Alert_Status).toUpperCase() !== \"SENT\") {\n    continue;\n  }\n\n  // Find the matching employee task\n  const task = taskMap.get(cycleId);\n\n  // Only pending tasks can be escalated\n  if (\n    !task ||\n    String(task.Status || \"\").trim().toLowerCase() !== \"pending\"\n  ) {\n    continue;\n  }\n\n  const sentAt = new Date(\n    String(alert.Alert_Sent_At).replace(\" \", \"T\") + \"+05:30\"\n  );\n\n  if (isNaN(sentAt.getTime())) continue;\n\n  const hoursElapsed =\n    (now.getTime() - sentAt.getTime()) / 3600000;\n\n  results.push({\n    json: {\n      ...alert,\n      Hours_Since_Alert: Number(hoursElapsed.toFixed(2)),\n      Manager_Acknowledgement_Overdue: hoursElapsed >= 2,\n      Leadership_Escalation_Due: hoursElapsed >= 4\n    }\n  });\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
