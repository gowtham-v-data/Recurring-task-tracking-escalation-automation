      "id": "0f333a23-91bd-415d-ab06-7ae455c5f658",
      "name": "Identify Unacknowledged Manager Alerts",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const alerts = $input.all();\n\nconst results = alerts.filter(item => {\n  const alert = item.json;\n\n  return (\n    alert.Leadership_Escalation_Due === true &&\n    String(alert.Leadership_Escalated).toLowerCase() !== \"true\"\n  );\n});\n\nreturn results.map(item => ({\n  json: {\n    ...item.json,\n    Leadership_Escalation_Type: \"UNACKNOWLEDGED_MANAGER\",\n    Escalation_Reason: \"Manager failed to acknowledge within 4 hours\"\n  }\n}));"
      },
