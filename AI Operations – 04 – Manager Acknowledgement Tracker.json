      "name": "Combine Task and Acknowledgement Records"
    },
    {
      "parameters": {
        "jsCode": "const tasks = $(\"Read Manager Acknowledgement Status\").all();\nconst alerts = $(\"Read Manager Acknowledgement Records\").all();\n\nconst alertMap = new Map();\n\nfor (const item of alerts) {\n  const alert = item.json;\n  const cycleId = String(alert.Cycle_ID || \"\").trim();\n\n  if (cycleId) {\n    alertMap.set(cycleId, alert);\n  }\n}\n\nconst results = [];\n\nfor (const item of tasks) {\n  const task = item.json;\n  const cycleId = String(task.Cycle_ID || \"\").trim();\n\n  if (!cycleId) continue;\n\n  const alert = alertMap.get(cycleId);\n\n  if (!alert) continue;\n\n  const acknowledged =\n    String(task.Manager_Acknowledged).toLowerCase() === \"true\";\n\n  const loggedAcknowledged =\n    String(alert.Manager_Acknowledged).toLowerCase() === \"true\";\n\n  if (acknowledged && !loggedAcknowledged) {\n    results.push({\n      json: {\n        Alert_ID: alert.Alert_ID,\n        Cycle_ID: cycleId,\n        Task_ID: task.Task_ID,\n        Employee: task.Assigned_To,\n        Manager_Email: alert.Manager_Email,\n        Manager_Acknowledged: true,\n        Manager_Acknowledged_At:\n          task.Manager_Acknowledged_At || \"\",\n        Alert_Status: \"ACKNOWLEDGED\"\n      }\n    });\n  }\n}\n\nreturn results;"
      },
