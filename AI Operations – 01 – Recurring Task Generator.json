    {
      "parameters": {
        "jsCode": "\nconst records = $input.all();\n\n// Separate Task_Master records and existing task cycles\nconst tasks = records.filter(item => item.json.First_Due_Date);\nconst existingCycles = records.filter(item => item.json.Cycle_ID);\n\nconst results = [];\n\nfor (const item of tasks) {\n  const task = item.json;\n\n  if (task.Active !== true && String(task.Active).toLowerCase() !== \"true\") {\n    continue;\n  }\n\n  const frequency = Number(task.Frequency_Days);\n  const firstDue = new Date(`${task.First_Due_Date}T00:00:00Z`);\n\n  if (!Number.isFinite(frequency) || frequency < 1 || isNaN(firstDue.getTime())) {\n    continue;\n  }\n\n  const taskCycles = existingCycles\n    .map(x => x.json)\n    .filter(x => String(x.Task_ID).trim() === String(task.Task_ID).trim())\n    .sort((a, b) => String(b.Due_Date).localeCompare(String(a.Due_Date)));\n\n  let nextDue = new Date(firstDue);\n\n  if (taskCycles.length > 0) {\n    const latestCycle = taskCycles[0];\n\n    if (String(latestCycle.Status).trim().toLowerCase() !== \"completed\") {\n      continue;\n    }\n\n    nextDue = new Date(`${latestCycle.Due_Date}T00:00:00Z`);\n    nextDue.setUTCDate(nextDue.getUTCDate() + frequency);\n  }\n\n  const dueDate = nextDue.toISOString().slice(0, 10);\n\n  results.push({\n    json: {\n      Cycle_ID: `${task.Task_ID}-${dueDate.replaceAll(\"-\", \"\")}`,\n      Task_ID: task.Task_ID,\n      Task_Name: task.Task_Name,\n      Assigned_To: task.Assigned_To,\n      Employee_Email: task.Employee_Email,\n      Due_Date: dueDate,\n      Due_Time: task.Due_Time,\n      Status: \"Pending\",\n      Ticket_ID: \"\",\n      Completion_Proof: \"\",\n      Completed_By: \"\",\n      Completed_At: \"\",\n      Manager_Acknowledged: false,\n      Manager_Acknowledged_At: \"\",\n      Escalation_Level: \"None\",\n      Frequency_Days: frequency,\n      Task_Type: task.Task_Type,\n      Required_Proof: task.Required_Proof,\n      Manager_Email: task.Manager_Email,\n      Leadership_Email: task.Leadership_Email\n    }\n  });\n}\n\nreturn results;\n"
      },
