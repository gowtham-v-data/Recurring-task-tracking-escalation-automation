    {
      "parameters": {
        "jsCode": "\nconst generatedTasks = $(\"Calculate Recurring Task Cycles\").all();\nconst existingRows = $(\"Read Existing Task Cycles\").all();\n\nconst existingCycleIds = new Set();\n\nconst pendingTaskIds = new Set();\n\nfor (const item of existingRows) {\n  const row = item.json;\n\n  const cycleId = String(row.Cycle_ID || \"\").trim();\n  const taskId = String(row.Task_ID || \"\").trim();\n  const status = String(row.Status || \"\").trim().toLowerCase();\n\n  if (cycleId) {\n    existingCycleIds.add(cycleId);\n  }\n\n  if (taskId && status === \"pending\") {\n    pendingTaskIds.add(taskId);\n  }\n}\n\nconst newTasks = generatedTasks.filter(item => {\n  const cycleId = String(item.json.Cycle_ID || \"\").trim();\n  const taskId = String(item.json.Task_ID || \"\").trim();\n\n  return (\n    cycleId &&\n    taskId &&\n    !existingCycleIds.has(cycleId) &&\n    !pendingTaskIds.has(taskId)\n  );\n});\n\nreturn newTasks;\n"
      },
