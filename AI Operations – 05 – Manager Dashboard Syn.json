    {
      "parameters": {
        "jsCode": "const tasks = $input.all();\nconst now = new Date();\n\nconst employees = {};\n\nfor (const item of tasks) {\n  const task = item.json;\n\n  const employee = String(task.Assigned_To || \"\").trim();\n  if (!employee) continue;\n\n  if (!employees[employee]) {\n    employees[employee] = {\n      Employee: employee,\n      Total_Tasks: 0,\n      Pending_Tasks: 0,\n      Overdue_Tasks: 0,\n      Completed_Tasks: 0,\n      Last_Completion: \"\",\n      Manager_Action_Required: false\n    };\n  }\n\n  const stats = employees[employee];\n\n  stats.Total_Tasks++;\n\n  const status = String(task.Status || \"\")\n    .trim()\n    .toLowerCase();\n\n  if (status === \"completed\") {\n    stats.Completed_Tasks++;\n\n    const completedAt = String(task.Completed_At || \"\");\n\n    if (\n      completedAt &&\n      (!stats.Last_Completion ||\n       completedAt > stats.Last_Completion)\n    ) {\n      stats.Last_Completion = completedAt;\n    }\n  } else if (status === \"pending\") {\n    stats.Pending_Tasks++;\n\n    const dueDateTime = new Date(\n      `${task.Due_Date}T${task.Due_Time}:00+05:30`\n    );\n\n    if (!isNaN(dueDateTime.getTime()) &&\n        now > dueDateTime) {\n      stats.Overdue_Tasks++;\n    }\n  }\n\n  if (\n    status === \"pending\" &&\n    String(task.Manager_Acknowledged).toLowerCase() !== \"true\" &&\n    stats.Overdue_Tasks > 0\n  ) {\n    stats.Manager_Action_Required = true;\n  }\n}\n\nreturn Object.values(employees).map(employee => ({\n  json: employee\n}));\n"
      },
