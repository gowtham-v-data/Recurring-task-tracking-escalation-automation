    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst results = [];\n\nfor (const item of rows) {\n  const row = item.json;\n\n  if (String(row.Status || \"\").trim().toLowerCase() !== \"completed\") {\n    continue;\n  }\n\n  const taskId = String(row.Task_ID || \"\").trim();\n  const cycleId = String(row.Cycle_ID || \"\").trim();\n  const ticketId = String(row.Ticket_ID || \"\").trim();\n  const proof = String(row.Completion_Proof || \"\").trim();\n\n  if (!cycleId || !taskId) {\n    continue;\n  }\n\n  const isDailyWhatsApp = taskId === \"TSK001\";\n\n  if (isDailyWhatsApp && !proof) {\n    continue;\n  }\n\n  if (!isDailyWhatsApp && !ticketId) {\n    continue;\n  }\n\n  results.push({\n    json: {\n      ...row,\n      Verification_Status: \"Valid\",\n      Completion_ID: cycleId\n    }\n  });\n}\n\nreturn results;\n"
      },
