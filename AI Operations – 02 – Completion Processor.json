    {
      "parameters": {
        "jsCode": "\nconst validCompletions = $(\"Validate Task Completion\").all();\n\nconst existingRows = $(\"Read Existing Completion Records\").all();\n\nconst existingIds = new Set(\n  existingRows\n    .map(item => String(item.json.Completion_ID || \"\").trim())\n    .filter(id => id !== \"\")\n);\n\nconst newCompletions = validCompletions.filter(item => {\n  const completionId = String(\n    item.json.Completion_ID || \"\"\n  ).trim();\n\n  return completionId && !existingIds.has(completionId);\n});\n\nreturn newCompletions.map(item => ({\n  json: item.json\n}));\n"
      },
