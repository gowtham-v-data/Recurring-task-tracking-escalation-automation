    {
      "parameters": {
        "jsCode": "const overdueTasks = $(\"Filter New Manager Alerts\").all();\nconst masterTasks = $(\"Read Task Master for Alert Recipients\").all();\n\nconst taskMasterMap = new Map(\n  masterTasks.map(item => [\n    String(item.json.Task_ID).trim(),\n    item.json\n  ])\n);\n\nreturn overdueTasks.map(item => {\n  const task = item.json;\n  const master = taskMasterMap.get(\n    String(task.Task_ID).trim()\n  );\n\n  if (!master) {\n    return null;\n  }\n\n  return {\n    json: {\n      ...task,\n      Manager_Email: master.Manager_Email,\n      Leadership_Email: master.Leadership_Email\n    }\n  };\n}).filter(Boolean);"
      },
