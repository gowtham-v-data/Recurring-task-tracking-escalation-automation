    {
      "parameters": {
        "jsCode": "const overdueTasks = $(\"Identify Overdue Tasks\").all();\nconst existingAlerts = $(\"Read Existing Escalation Records\").all();\n\nconst existingAlertIds = new Set(\n  existingAlerts\n    .map(item => String(item.json.Alert_ID || \"\").trim())\n    .filter(Boolean)\n);\n\nconst newAlerts = overdueTasks.filter(item => {\n  const cycleId = String(item.json.Cycle_ID || \"\").trim();\n  const alertId = `${cycleId}-MANAGER_OVERDUE`;\n\n  return cycleId && !existingAlertIds.has(alertId);\n});\n\nreturn newAlerts.map(item => ({\n  json: {\n    ...item.json,\n    Alert_ID: `${item.json.Cycle_ID}-MANAGER_OVERDUE`,\n    Alert_Type: \"MANAGER_OVERDUE\"\n  }\n}));"
      },
