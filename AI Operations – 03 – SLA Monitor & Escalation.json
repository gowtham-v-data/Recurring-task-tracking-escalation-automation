    {
      "parameters": {
        "jsCode": "const tasks = $input.all();\nconst now = new Date();\n\nconst MANAGER_ALERT_DELAY_MINUTES = 15;\n\nconst overdueTasks = [];\n\nfor (const item of tasks) {\n  const task = item.json;\n\n  if (\n    String(task.Status || \"\").trim().toLowerCase() !== \"pending\"\n  ) {\n    continue;\n  }\n\n  const dueDateTime = new Date(\n    `${task.Due_Date}T${task.Due_Time}:00+05:30`\n  );\n\n  if (isNaN(dueDateTime.getTime())) {\n    continue;\n  }\n\n  const alertTime = new Date(\n    dueDateTime.getTime() +\n    MANAGER_ALERT_DELAY_MINUTES * 60 * 1000\n  );\n\n  if (now >= alertTime) {\n    overdueTasks.push({\n      json: {\n        ...task,\n        Alert_Type: \"OVERDUE\",\n        Overdue_Detected_At: now.toISOString()\n      }\n    });\n  }\n}\n\nreturn overdueTasks;"
      },
